# Where fetch_drivers.py looks for images. Copy this file to `.env` (it is not committed) and fill it in.
# More in scripts/README.md

# Sitemap(s), separated by spaces: one page per driver and an image in each
DRIVERS_SITEMAP_URL=https://example.com/drivers-sitemap.xml

# Part of the URL that the pages of the drivers have in common (optional, `/drivers/` by default)
# DRIVERS_PAGE_PATH=/drivers/

# URL templates, separated by spaces, for the drivers that are still missing (optional)
# Placeholders: {id}  {tla}  {ref}  {year}
DRIVERS_FALLBACK_URLS=https://example.com/headshots/{year}/{tla}.png
